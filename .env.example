# Copy to .env for local runs, or set these as environment secrets in the cloud environment.
# NEVER commit real values. Agents must never read .env (denied in .claude/settings.json).

# --- Safety (defaults are safe) ---
MBM_DRY_RUN=1                 # 1 = no posting, no DMs, no paid renders
MBM_ACTIVE_BRAND=_template    # folder under brands/
MBM_DAILY_BUDGET_USD=10       # placeholder: set from your real budget
MBM_VIDEO_BUDGET_USD=2        # per-video cap across LLM + GPU

# --- Supabase (state + media + memory) ---
SUPABASE_URL=
SUPABASE_SERVICE_KEY=         # use a restricted key for agents: no INSERT on gate_approvals
SUPABASE_REVIEWER_KEY=        # HUMAN-ONLY: lets `store approve/reject` run. Leave unset in scheduled/headless runs
SUPABASE_STORAGE_BUCKET=mbm-media

# --- Comfy API deployment (primary compute) ---
COMFY_API_KEY=
COMFY_BASE_URL=               # https://<deployment>.run.comfy.app
COMFY_DEPLOYMENT_ID=          # dep_...

# --- Integrations ---
BLOTATO_API_KEY=
APIFY_TOKEN=
MANYCHAT_API_KEY=

# --- Plan B compute (RunPod serverless), optional ---
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=
