{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/concept.schema.json",
  "title": "Video Concept",
  "description": "One original-persona video concept. Maps to the `concepts` table. Starts as `drafted`; gate G1 is human.",
  "type": "object",
  "required": ["brief_id", "brand", "variant", "title", "hook_line", "beats", "shot_list", "caption", "hashtags", "audio_plan", "cta_keyword", "comfy_recipe", "engagement_trigger"],
  "additionalProperties": false,
  "properties": {
    "brief_id": { "type": "string", "format": "uuid" },
    "brand": { "type": "string", "minLength": 1 },
    "variant": { "type": "string", "enum": ["A", "B", "C"] },
    "title": { "type": "string", "minLength": 1, "maxLength": 120 },
    "hook_line": { "type": "string", "minLength": 1, "description": "Lands within 3 seconds" },
    "beats": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["t_start", "t_end", "action"],
        "additionalProperties": false,
        "properties": {
          "t_start": { "type": "number", "minimum": 0 },
          "t_end": { "type": "number", "minimum": 0 },
          "action": { "type": "string" },
          "line": { "type": ["string", "null"] }
        }
      }
    },
    "shot_list": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["t", "desc"],
        "additionalProperties": false,
        "properties": {
          "t": { "type": "number", "minimum": 0 },
          "desc": { "type": "string" },
          "camera": { "type": ["string", "null"] }
        }
      }
    },
    "voiceover": { "type": ["string", "null"] },
    "on_screen_text": { "type": "array", "items": { "type": "object", "required": ["t", "text"], "additionalProperties": false, "properties": { "t": { "type": "number" }, "text": { "type": "string" } } } },
    "caption": { "type": "string" },
    "hashtags": { "type": "array", "items": { "type": "string" } },
    "audio_plan": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string", "enum": ["original", "licensed_track", "trending_sound_human_added"] },
        "notes": { "type": ["string", "null"] }
      }
    },
    "engagement_trigger": {
      "type": "object",
      "required": ["kind", "why"],
      "additionalProperties": false,
      "properties": {
        "kind": { "type": "string", "enum": ["share", "comment", "save"] },
        "why": { "type": "string" }
      }
    },
    "cta_keyword": { "type": "string", "pattern": "^[A-Z0-9]{3,20}$" },
    "comfy_recipe": {
      "type": "object",
      "required": ["workflow", "params"],
      "additionalProperties": false,
      "properties": {
        "workflow": { "type": "string", "minLength": 1 },
        "params": { "type": "object" }
      }
    },
    "compliance": {
      "type": "object",
      "properties": {
        "stage": { "type": "string" },
        "pass": { "type": "boolean" },
        "issues": { "type": "array", "items": { "type": "object" } }
      }
    }
  }
}
